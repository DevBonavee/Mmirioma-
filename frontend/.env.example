# Copy to .env.local:  cp .env.example .env.local
# Only VITE_-prefixed variables reach the browser; never put secrets here.

# Base URL of the FastAPI backend (no trailing slash).
VITE_API_BASE_URL=http://localhost:8000

# Serve typed mock data from src/mocks instead of calling the API.
# 'true' while backend endpoints for the new design do not exist yet.
VITE_USE_MOCKS=true

# Public VAPID key for phone (push) notifications, base64url. Public by
# design; the matching private key lives only on the backend. Leave empty
# until the push endpoints exist (docs/api/push.md).
VITE_VAPID_PUBLIC_KEY=

# Map style (tile provider) for the landing page's service-area map. Public by
# design. Leave empty for the OpenFreeMap default; to change provider, put the
# provider's style URL here (docs/architecture/maps.md).
VITE_MAP_STYLE_URL=

# The message form on the Contact page (/contact, #344). Off unless 'true'.
# It stays off in production until the four conditions in
# docs/design/contact.md ("Switching the form on") are met. Set 'true' here to
# try the form locally. Read when the frontend is built: restart `npm run dev`
# or rebuild after changing it.
VITE_CONTACT_FORM_ENABLED=false
